{
    "compilerOptions": {
        "target": "ES2021",
        "module": "commonjs",
        "lib": ["es2022", "dom"],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": false,
        "noImplicitAny": true,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "tsBuildInfoFile": ".tsbuildinfo",
        "incremental": true,
    },
    "include": ["src/", "tests/"],
    "exclude": [],
}
